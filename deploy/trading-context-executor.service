[Unit]
Description=Trading Context Hyperliquid Executor
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=trading_context_scanner
Group=trading_context_scanner
WorkingDirectory=/opt/trading_context_scanner
EnvironmentFile=/opt/trading_context_scanner/.env
Environment=PYTHONUNBUFFERED=1
Environment=HYPERLIQUID_ENABLE_MAINNET=false
Environment=HYPERLIQUID_ENABLE_TESTNET=false
ExecStart=/opt/trading_context_scanner/.venv/bin/python -m app.execution_service
Restart=always
RestartSec=10
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
