# PostgreSQL production configuration
# Use a non-admin user for the application; never commit a real .env file.
DATABASE_URL=postgresql://trading_context_scanner:CHANGE_ME@127.0.0.1:5432/trading_context_scanner

# Flask web base URL used by the app when rendering links
WEB_BASE_URL=http://127.0.0.1:5000

# Use "production" on the VPS; production requires a strong AUTH_SECRET_KEY
# and always enables the Secure session cookie.
APP_ENV=development
# Generate a unique random value for each environment; never reuse this placeholder.
AUTH_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET
# Set to true in HTTPS production. Keep false for local HTTP development.
SESSION_COOKIE_SECURE=false

# Set MASTER_PASSWORD only in the process environment when running the seed command.
# Do not put the real value in this file.
MASTER_LOGIN=izicode
MASTER_NAME=izicode

# Optional legacy CSV path used only when DATABASE_URL is not configured
SIGNALS_CSV_PATH=data/signals.csv